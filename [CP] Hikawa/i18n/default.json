    // Bugs
    // scientific names should not be localised

    "bugs.furniture.none": "You haven't caught any bugs yet.",

    "bugs.stag.name": "Stag Beetle",
    "bugs.stag.scientific": "Prosopocoilus inclinatus",
    "bugs.stag.description": "Their mandibles grow throughout their lifetime to the length of their body.\n\nMales wrestle one-another for females, food, and territory. Despite their size, they remain capable flyers.",
    "bugs.stag.message": "Nice bug, @. Hope you didn't get pinched catching it!#$b#I'll probably need to get it in a bigger container, this is one big bug.#$e#While you're here, wanna see this millipede I found?$h{{action}}",

    "bugs.butterfly.name": "Monarch Butterfly",
    "bugs.butterfly.scientific": "Danaus plexippus",
    "bugs.butterfly.description": "Renowned for their continental migration patterns, species are found wherever their preferred food grows, as well as at 'rest-stops' along their migratory routes.\n\nScales may be coloured orange, white, or blue.",
    "bugs.butterfly.message": "Good catch! These butterflies are on their annual migratory route at this time of year.$h#$b#By the summer, they should be enjoying the warm weather in the islands south of here. They must be happy to rest at the hilltop on the way, though.{{action}}",

    "bugs.wasp.name": "Paper Wasp",
    "bugs.wasp.scientific": "Polistes chinensis",
    "bugs.wasp.description": "As with bees, a lone queen founds a nest, hatching female workers to grow her brood.\n\nAn adult wasp can't feed on solid matter; her mandibles are mainly for pulping wood fiber into paper. She subsists on nectar and feeds chewed insects to her larvae.",
    "bugs.wasp.message": "Hm, you've caught something? .. Wow, a paper wasp!#$b#You needn't look so worried, they're really quite docile. Or at least, they are before you shove them in a jar.#$b#Actually, this one's starting to look real mad.$s{{action}}",

    "bugs.cicada.name": "Emperor Cicada",
    "bugs.cicada.scientific": "Hyalessa maculaticollis",
    "bugs.cicada.description": "Named for its jeweled colour, they spend 3 years burrowing underground as nymphs, emerging for their final molt in mid-summer.\n\nMales perform their song by forcing air through vibrating membranes into their echoic abdomen.",
    "bugs.cicada.message": "Having fun collecting bugs? I've found two types of earwigs and a lovely fluffy moth this week.#$b#It's amazing how many different species live right beside us, you'd never notice if you weren't looking for them.{{action}}",

    "bugs.mantis.name": "Orchid Mantis",
    "bugs.mantis.scientific": "Hymenopus coronatus",
    "bugs.mantis.description": "Beautiful predators with jaw-like legs and powerful mandibles.\n\nCan change their camouflage at will, ambushing pollinating insects before they can react.\nFemales grow to twice the size of males, devouring them after mating.",
    "bugs.mantis.message": "Wow, these are much more beautiful than in the handbook! You must've found her hiding in the azaleas, right?#$b#See, even in the jar it's trying to move with the wind. You must've caught a swaying mantis!$h{{action}}",

    "bugs.woodlouse.name": "Woodlouse",
    "bugs.woodlouse.scientific": "Porcellionidae",
    "bugs.woodlouse.description": "Nocturnal detritivores that decompose wood, manure, and other plant matter.\nDescendants of ancient marine isopods, they adapted to live in damp habitats on land. Rolls into a ball when scared.\n\nVery cute little friends.",
    "bugs.woodlouse.message": "How cute, a roly-poly bug. They don't appear all that special, but they're truly unique relatives of marine crustaceans.#$b#Better find him some leaf litter. It must be nice being able to sleep in your food! Hee hee.{{action}}",

    "bugs.centipede.name": "Centipede",
    "bugs.centipede.scientific": "Scolopendridae",
    "bugs.centipede.description": "Aggressive predator that can subdue large prey with its envenomed pincer-like forelimbs, even though mostly blind.\nCan live for up to 10 years, growing new legs with every moult.\n\nExtremely uncute. May take a lot of pins.",
    "bugs.centipede.message": "Oh, you've got another specimen? Let me see..#$b# . . . #$b#.. EEK!$s#$b#Hold on, I'll fetch you a new jar.. this one's staying closed. Forever.$s{{action}}",

    "bugs.moth.name": "Moon Moth",
    "bugs.moth.scientific": "Actias luna",
    "bugs.moth.description": "Large silk moth with a ghostly scale.\n\nLarvae thrive on cherry and maple trees in the region, while adults survive only on larval energy stores.\n\nRelative of Actias artemis. So cute!",
    "bugs.moth.message": "Whoa, that's the biggest moth I've seen. I hope you were gentle, their scales brush off like powder.#$b#It really looks like Usagi with those tails.. but I don't think she'd much like being compared to a bug, heehee.$h{{action}}",

    "bugs.termite.name": "Termite",
    "bugs.termite.scientific": "Rhinotermitidae",
    "bugs.termite.description": "Feeding voraciously on exposed wood, colonies of millions can spread far underground.\n\nDivided into dimorphic social castes, workers and soldiers support eachother under a breeding king and queen. May develop wings and swarm in search of food.",
    "bugs.termite.message": "A termite? It's so small, I wonder if it's able to squeeze through the airholes in the lid.#$b#Better find a mesh cover, Rei's going to explode if she finds out I let a jar of termites loose in her house.$s{{action}}",

    "bugs.ladybird.name": "Ladybird",
    "bugs.ladybird.scientific": "Coccinellidae",
    "bugs.ladybird.description": "Deceptively cute predators of small garden pests. Can reach extreme ranges and altitudes.\nWingcases may come in a variety of colours and patterns.\n\nPretty guardians of the rose garden! Mako won't be happy if I pin any more of these...",
    "bugs.ladybird.message": "What a sweet little beetle! You'd never think they're really the vicious marauders of even-tinier little insects.#$b#Here, you'll need another bug jar. Good luck!{{action}}",

    "bugs.dragonfly.name": "Dragonfly",
    "bugs.dragonfly.scientific": "Libellulidae",
    "bugs.dragonfly.description": "Agile aerial aces with precise flight and sight. Preferred habitats are vegetated freshwater bodies such as lakes, rivers, and wetlands.\n\nHatchling nymphs develop underwater for several years, emerging in waves to spawn and die.",
    "bugs.dragonfly.message": "A dragonfly! I'm surprised you even managed to catch one up here, it must've flown up from the mountain lakes.#$b#You'd never find one of these in the city, I've only ever seen them in paintings. They're like little flying jewels!{{action}}",

    "bugs.scarab.name": "Jewel Beetle",
    "bugs.scarab.scientific": "Scarabaeidae",
    "bugs.scarab.description": "Rarely-seen beetles with an iridescent carapace, only found in mountainous coniferous forests. Little is known about their behavior.\n\nTheir metallic sheen comes from layers of uniquely-reflective chitin. Colour and luster varies wildly by species!",
    "bugs.scarab.message": "No way, you found a real-live jewel beetle! And on this very hill, too!#$b#My handbook doesn't even mention a habitable zone for jewel beetles, I never thought you'd actually catch one.#$b#Nice work, @.$h{{action}}",

    // Shrubs

    "shrubs.error.placement": "Cannot be placed here.",
    "shrubs.error.close": "Too close to other plants.",
    "shrubs.error.growth": "Your {{shrub}} wasn't able to grow last night.",
